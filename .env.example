# Pusher Channels — get from https://dashboard.pusher.com
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Vercel KV — auto-populated when you connect a KV store in Vercel dashboard
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Frontend (prefix with VITE_ so Vite exposes them to the browser)
VITE_PUSHER_KEY=        # same value as PUSHER_KEY
VITE_PUSHER_CLUSTER=    # same value as PUSHER_CLUSTER
